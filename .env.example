# Copy to .env and edit (or add these to OpenLobby's .env: the override runs
# in OpenLobby's compose project, which reads that file). Every value is
# optional; an EMPTY value means "use the built-in default".

# The address a Tetra Master client dials for its zones (written into the
# zone list). Default when empty: the core's POL_ADVERTISE.
POL_TM_ZONE_HOST=

# An event window, unix seconds. -1/-1 (the default) = no event. Both must be
# set for the event board and countdown to turn on.
POL_TM_EVENT_START=
POL_TM_EVENT_END=

# Who is on the event board when an event is on: "hexid:name:score,..." in
# placing order (member ids in hex). Empty = an empty board.
POL_TM_EVENT_MEMBERS=

# Set to "now" to publish the ranking lists at start as well as weekly.
TM_RANK_AT=

# Live board (--profile board): the public URL the Discord messages link to,
# and the webhooks to post standings and listings to. Empty = no Discord.
POL_BOARDS_TM_URL=
POL_BOARDS_TM_DISCORD_WEBHOOK=
POL_BOARDS_TM_AUCTION_DISCORD_WEBHOOK=
